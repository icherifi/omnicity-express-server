# Copy to .env and fill in real values. .env is gitignored — never commit it.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only — bypasses RLS. Never expose to a client, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Virtual staging (Claude + plain Node/Three.js - see src/services/)
ANTHROPIC_API_KEY=
ANTHROPIC_STAGING_MODEL=claude-sonnet-5
# IKEA storefront to search (affects pricing/availability/which products have a 3D model).
IKEA_COUNTRY=fr
IKEA_LANGUAGE=fr
IKEA_CACHE_DIR=ikea_cache
# espace-client's own address - stagingRenderService.ts points a headless
# Playwright browser at ${STAGING_RENDER_BASE_URL}/internal/staging-render to
# screenshot Claude's self-check preview.
STAGING_RENDER_BASE_URL=http://localhost:3000
