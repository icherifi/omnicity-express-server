# Copy to .env and fill in real values. .env is gitignored — never commit it.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only — bypasses RLS. Never expose to a client, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Virtual staging (Claude + plain Node/Three.js - see src/services/)
ANTHROPIC_API_KEY=
ANTHROPIC_STAGING_MODEL=claude-sonnet-5
# IKEA storefront to search (affects pricing/availability/which products have a 3D model).
IKEA_COUNTRY=fr
IKEA_LANGUAGE=fr
IKEA_CACHE_DIR=ikea_cache
# espace-client's own address - stagingRenderService.ts points a headless
# Playwright browser at ${STAGING_RENDER_BASE_URL}/internal/staging-render to
# screenshot Claude's self-check preview.
STAGING_RENDER_BASE_URL=http://localhost:3000

# --- Multi-user / production ---------------------------------------------------
# Comma separated list of browser origins allowed to call this API (the espace-client URL).
# localhost origins are accepted automatically when NODE_ENV != production.
CORS_ORIGINS=http://localhost:3000
# Max JSON body size (room scans). Default 25mb.
# JSON_BODY_LIMIT=25mb
# Max concurrent staging runs per user (each one costs Claude credits). Default 1.
# STAGING_MAX_ACTIVE_PER_USER=1

# --- Third parties (previously hard-coded in the source) -------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADEME_CLIENT_ID=
ADEME_CLIENT_SECRET=
# Full Authorization header value for the IZI QR API, e.g. "Bearer xxxxx"
IZI_AUTH_TOKEN=

# --- Scripts only (scripts/verify-staging-e2e.ts) --------------------------------
# E2E_EMAIL=
# E2E_PASSWORD=
