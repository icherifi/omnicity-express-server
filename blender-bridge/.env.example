BRIDGE_API_KEY=change-me
# Full URL this bridge is reachable at from the Express server (VPN address, tunnel, or public URL + reverse proxy TLS).
BRIDGE_PUBLIC_URL=http://localhost:8000
BLENDER_EXECUTABLE=blender
BRIDGE_SESSIONS_DIR=sessions
BLENDER_SCRIPT_TIMEOUT=180
# IKEA storefront to search (affects pricing/availability/which products have a 3D model).
IKEA_COUNTRY=fr
IKEA_LANGUAGE=fr
IKEA_CACHE_DIR=ikea_cache
